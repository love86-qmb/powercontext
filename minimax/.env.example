# Real runs require a seekdb/OceanBase MySQL-compatible database.
SDD_DATABASE_URL=mysql://user:password@host:2881/database?charset=utf8mb4&ssl=required

# MiniMax Token Plan or pay-as-you-go API key. Never commit the real value.
MINIMAX_API_KEY=replace-me
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2

# A running PowerContext Server and optional access token.
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=
